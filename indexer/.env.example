# Copy to indexer/.env (never committed).
# HyperSync API token (https://envio.dev/app/api-tokens). With it the indexer syncs through HyperSync
# (Arbitrum Sepolia, chain 421614), with the RPC as fallback; without it, it syncs from the RPC alone.
ENVIO_API_TOKEN=
# Optional overrides
# ENVIO_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ENVIO_START_BLOCK=

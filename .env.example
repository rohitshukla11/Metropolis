# Copy to .env (never committed). No private keys here: deploy keys live in ../.secrets (mode 0600)
# or an encrypted Foundry keystore (`cast wallet import <name> --interactive`).

# Arbitrum Sepolia RPC: https://docs.arbitrum.io/for-devs/dev-tools-and-resources/chain-info
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Arbiscan verification (Etherscan V2 API key, one key for every Etherscan-family explorer).
ETHERSCAN_API_KEY=

# Optional deploy parameters (addresses only). Each defaults to the deployer.
ATTESTER=
RENDER_AGENT=
TREASURY=
FEE_BPS=1000
